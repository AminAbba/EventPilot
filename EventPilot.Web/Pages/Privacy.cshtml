@page
@model PrivacyModel
@{
    ViewData["Title"] = "Privacy";
}

<div class="ep-card bg-white p-4">
    <h2 class="fw-semibold mb-3">Privacy</h2>

    <p class="ep-muted">
        This is a demo project UI for EventPilot.
        If you deploy this publicly, make sure you:
    </p>

    <ul class="mb-0">
        <li>Store secrets (SMTP / JWT key) in user-secrets or environment variables</li>
        <li>Use HTTPS in production</li>
        <li>Never expose detailed auth errors to end users</li>
    </ul>
</div>
