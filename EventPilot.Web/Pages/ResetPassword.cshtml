@page
@model EventPilot.Web.Pages.ResetPasswordModel

<h2>Reset Password</h2>

@if (Model.InvalidLink)
{
    <p style="color:red">Invalid reset link.</p>
}
else
{
    <form method="post">
        <input type="hidden" asp-for="Email" />
        <input type="hidden" asp-for="Token" />

        <label>New Password</label>
        <input asp-for="NewPassword" type="password" />

        <button type="submit">Reset</button>
    </form>
}

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <p style="color:green">@Model.Message</p>
}
@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <p style="color:red">@Model.Error</p>
}
